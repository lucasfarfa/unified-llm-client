# Copiá este archivo como .env y completá tus valores.
# El .env está en .gitignore: tus keys nunca se suben al repo.

# Proveedor por defecto para AsyncLLMManager.from_env(): openai | anthropic
LLM_PROVIDER=openai

# API keys. Si dejás una vacía, main.py omite ese proveedor.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (verificados en la documentación oficial, nov. 2026)
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5

# Parámetros de generación
# Temperature: OpenAI acepta 0-2, Anthropic solo 0-1 (se valida igual, pero los
# modelos Claude 5.x no la usan: el cliente de Anthropic no la envía).
LLM_TEMPERATURE=0.7
# Tokens máximos de salida. En Anthropic incluyen los tokens de "thinking",
# por eso usamos 1024 y no un valor muy chico.
LLM_MAX_TOKENS=1024

# Reintentos automáticos del SDK ante errores transitorios (429, 5xx, red)
LLM_MAX_RETRIES=2

# Opcionales
# LLM_TIMEOUT=30
# LOG_LEVEL=INFO
